{:paths ["src"]
 ;; genspark 風 super-agent。既存の clj スタックの上の薄いオーケストレーション層 +
 ;; 自前 browser 層。すべて .cljc / 第三者ランタイム依存ゼロ（ADR-2606250956）。
 :deps {
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       io.github.kotoba-lang/browser-use
        {:git/url "https://github.com/kotoba-lang/browser-use.git"
                                     :git/sha "67f6ef3c159287c77a3e5e7c3fc8921cb7b4d958"}
        io.github.kotoba-lang/langgraph
        {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                     :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
        io.github.kotoba-lang/langchain
        {:git/url "https://github.com/kotoba-lang/langchain.git"
                                     :git/sha "51e7b61ec3d55e917d5dc77dac145197cb3340df"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/browser-use
                        {:git/url "https://github.com/kotoba-lang/browser-use.git"
                                     :git/sha "67f6ef3c159287c77a3e5e7c3fc8921cb7b4d958"}
                        io.github.kotoba-lang/langgraph
                        {:git/url "https://github.com/kotoba-lang/langgraph.git"
                                     :git/sha "577a59a9d5eb3ef90b81342f4673973f481ff7f4"}
                        io.github.kotoba-lang/langchain
                        {:git/url "https://github.com/kotoba-lang/langchain.git"
                                     :git/sha "51e7b61ec3d55e917d5dc77dac145197cb3340df"}}}
  ;; offline mock demo: clojure -M:dev:run
  :run {:extra-paths ["examples"]
        :main-opts ["-m" "research-demo"]}
  ;; Real owned browser via Playwright — see src/browseragent/browser/provider.cljc
  :playwright {:extra-paths ["examples"]
               :extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.44.0"}}}
  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}