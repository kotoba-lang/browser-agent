{:paths ["src"]
 ;; genspark 風 super-agent。既存の clj スタックの上の薄いオーケストレーション層 +
 ;; 自前 browser 層。すべて .cljc / 第三者ランタイム依存ゼロ（ADR-2606250956）。
 :deps {io.github.kotoba-lang/browser-use
        {:local/root "../browser-use"}
        io.github.kotoba-lang/langgraph
        {:local/root "../langgraph"}
        io.github.kotoba-lang/langchain
        {:local/root "../langchain"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; local checkouts for workspace development (orgs/kotoba-lang/*)
  :dev {:override-deps {io.github.kotoba-lang/browser-use
                        {:local/root "../browser-use"}
                        io.github.kotoba-lang/langgraph
                        {:local/root "../langgraph"}
                        io.github.kotoba-lang/langchain
                        {:local/root "../langchain"}}}
  ;; offline mock demo: clojure -M:dev:run
  :run {:extra-paths ["examples"]
        :main-opts ["-m" "research-demo"]}
  ;; Real owned browser via Playwright — see src/browseragent/browser/provider.cljc
  :playwright {:extra-paths ["examples"]
               :extra-deps {com.microsoft.playwright/playwright {:mvn/version "1.44.0"}}}}}
