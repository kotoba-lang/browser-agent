;; ClojureScript front-end (P4). Build: `npx shadow-cljs watch app`.
;; Shares browseragent.events (.cljc) with the server by putting the
;; library src on the classpath — the same projection renders both sides.
{:source-paths ["src" "../src"]
 :dependencies [[reagent "1.2.0"]
                [re-frame "1.4.3"]]
 :builds
 {:app {:target :browser
        :output-dir "public/js"
        :asset-path "/js"
        :modules {:main {:init-fn browser-agent-ui.core/init}}
        :devtools {:http-root "public" :http-port 8700}}}}
